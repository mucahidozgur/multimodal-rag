# === Veritabanı ===
# Host'tan koşan araçlar (alembic, pytest) için localhost; docker compose
# container içinde bu değeri "postgres:5432/multi" ile override eder.
DATABASE_URL=postgresql+asyncpg://multi:multi@localhost:5435/multi

# === Groq LLM ===
# https://console.groq.com/keys adresinden ücretsiz alınır (ZORUNLU)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
# Groq Vision (grafik/figure okuma — Faz 3). llama-3.2-90b-vision-preview
# Groq'ta kaldırıldı; güncel vision modeli aşağıdadır.
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# === Embeddings ===
# local: sentence-transformers (lokal geliştirme) | cloudflare: Workers AI
# (Render free tier — model RAM'e yüklenmez; CLOUDFLARE_* zorunlu)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5

# === Auth (JWT) ===
# Prod'da mutlaka değiştirin
JWT_SECRET=changeme
JWT_ALG=HS256
JWT_EXPIRE_MIN=1440

# === CORS ===
CORS_ORIGINS=["http://localhost:3003"]

# === Test izolasyonu ===
# Host pytest'i bu DB'ye bağlanır; set değilse test temizliği atlanır (guard).
# Not: Bu DB, scripts/init-db.sh ile ilk volume oluşturulurken otomatik açılır;
# mevcut bir kurulumda elle: CREATE DATABASE multi_test OWNER multi;
TEST_DATABASE_URL=postgresql+asyncpg://multi:multi@localhost:5435/multi_test
